# Caddy: gets and renews a Let's Encrypt certificate automatically.
# 1. Point your domain's DNS (A record) at this server, open ports 80 and 443.
# 2. Replace api.example.com with your domain.
# 3. Copy to /etc/caddy/Caddyfile, then: sudo systemctl reload caddy
#
# In .env for the Node app:  NODE_ENV=production  TRUST_PROXY=1  HOST=127.0.0.1

api.example.com {
	encode gzip

	reverse_proxy 127.0.0.1:4000
	# Caddy sends X-Forwarded-For / X-Forwarded-Proto by default,
	# and redirects http:// to https:// automatically.
}

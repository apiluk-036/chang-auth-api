{
  "name": "chang-auth-api",
  "version": "1.1.0",
  "private": true,
  "description": "Register / login API (Express + MySQL + JWT) with login and register pages",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js | pino-pretty",
    "start:prod": "NODE_ENV=production node server.js",
    "migrate": "node scripts/migrate.js",
    "make-admin": "node scripts/make-admin.js",
    "db:up": "docker compose up -d mysql",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "nodemailer": "^10.0.11",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0"
  }
}

# Copy to .env and fill in

# development | production
NODE_ENV=development
PORT=4000
# production default is 127.0.0.1 (reachable only through Nginx/Caddy)
# HOST=127.0.0.1

# Number of proxies in front of Node (Nginx/Caddy = 1).
# production default is 1, development default is 0.
# Do NOT set this if nothing sits in front of Node.
# TRUST_PROXY=1

# Other websites allowed to call the API, comma-separated.
# Leave empty if the UI is served by this app (public/).
# CORS_ORIGIN=https://app.example.com,http://localhost:5173
CORS_ORIGIN=

# Either a single URL...
DATABASE_URL=mysql://chang_app:password@localhost:3306/chang_db
# ...or separate values (leave DATABASE_URL empty to use these)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=chang_app
# DB_PASSWORD=password
# DB_NAME=chang_db

# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Public address of the site, used for links in emails. Required in production.
# APP_URL=https://app.example.com
APP_URL=http://localhost:4000

# Email (verification / password reset). Without SMTP_URL, emails are written
# to the log instead (fine for development, not for production).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Chang Auth <no-reply@example.com>

# Runs pending migrations/ on start. Set false to run `npm run migrate` yourself.
# MIGRATE_ON_START=true

# trace | debug | info | warn | error | fatal | silent
# LOG_LEVEL=info

# Per-IP limit for register / login / reset (per 15 minutes)
# RATE_LIMIT_IP_MAX=20

# Only for `npm test`. Tests DELETE ALL DATA here; name must contain "test".
# TEST_DATABASE_URL=mysql://chang_app:password@localhost:3306/chang_test
